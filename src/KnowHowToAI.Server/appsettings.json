{
  // KnowHowToAI – Nicht-geheime Anwendungsdefaults für V1.
  // Alle Werte werden beim Serverstart validiert; ungültige Werte verhindern den Start.
  // Überschreibungsreihenfolge (aufsteigend):
  //   1. Diese Datei
  //   2. appsettings.{Environment}.json
  //   3. Environment-Variablen (Doppelunterstrich als Trenner, z.B. KnowHowToAI__Retrieval__MaximumPageSize=200)
  //   4. Kommandozeilenargumente
  //
  // Die Datenbankverbindung steht bewusst in der separaten Sektion DatabaseConnection.
  // Platzhalter im Serverwert, etwa %COMPUTERNAME%, werden erst zur Laufzeit aufgelöst.
  "DatabaseConnection": {
    "Server": "%COMPUTERNAME%\\MSSQLSERVER2022",
    "Database": "KnowHowToAi",
    "UserName": "KnowHowToAi",
    "Password": "!KnowHowToAi!",
    "UseWindowsAuthentication": false
  },
  // Ausschließlich die Browser-E2E-Suite verwendet diese manuell bereitgestellte,
  // dedizierte Datenbank. Der Testhost übernimmt die fünf Werte prozesslokal in
  // DatabaseConnection; sie werden nie von einem Produktprozess ausgewählt.
  "BrowserTestDatabaseConnection": {
    "Server": "%COMPUTERNAME%\\MSSQLSERVER2022",
    "Database": "KnowHowToAi_Test",
    "UserName": "KnowHowToAi",
    "Password": "!KnowHowToAi!",
    "UseWindowsAuthentication": false
  },
  "Logging": {
    // Kleinstes protokolliertes Level (gültig: Verbose, Debug, Information, Warning, Error, Fatal).
    // Der MCP-Transport schreibt Roh-Payloads nur auf Trace-Ebene; der Default liegt darüber.
    "MinimumLevel": "Information",
    // Optionale Zieldatei für zusätzliche Protokollausgaben (täglich rotierend);
    // null bedeutet reinen stderr-Kanal.
    "FilePath": null
  },
  "KnowHowToAI": {
    "Validation": {
      // NodeTooLarge ab dieser normalisierten UTF-8-Größe (gültig: 512..1048576)
      "ContentSizeWarningBytes": 4096,
      // TooManyChildren ab dieser direkten Kindknoten-Anzahl (gültig: 2..10000)
      "ChildCountWarning": 25,
      // HierarchyTooDeep ab dieser globalen Node-Tiefe (gültig: 2..256)
      "HierarchyDepthWarning": 8,
      // Heuristische Warnung für alleinstehende Ersatztitel aktivieren
      "PossibleEmbeddedHeadingWarning": true
    },
    "Retrieval": {
      // Standardseite für Listen, z.B. list_children (gültig: 1..MaximumPageSize)
      "DefaultPageSize": 20,
      // Größte akzeptierte Listenseite (gültig: 1..1000)
      "MaximumPageSize": 100,
      // Standardseite für Suchergebnisse (gültig: 1..SearchMaximumPageSize)
      "SearchPageSize": 10,
      // Größte akzeptierte Such-Seite (gültig: 1..500)
      "SearchMaximumPageSize": 50,
      // Maximale Länge eines Suchsnippets in Zeichen (gültig: 50..4000)
      "SnippetMaximumCharacters": 300
    },
    "Storage": {
      // SQL-Command-Timeout in Sekunden (gültig: 1..600)
      "CommandTimeoutSeconds": 30
    },
    "Migrations": {
      // Warten auf den Migration-Lock in Sekunden (gültig: 1..600)
      "LockTimeoutSeconds": 60,
      // Ausstehende Migrationen beim Serverstart automatisch anwenden
      "ApplyOnStartup": true
    },
    "Auth": {
      // Dummy-Benutzername für authfreien Stand (wird als Actor für Transactions verwendet)
      "DummyUserName": "System"
    }
  }
}
