{
  // KnowHowTo AI – Nicht-geheime Anwendungsdefaults für V1.
  // Alle Werte werden beim Serverstart validiert; ungültige Werte verhindern den Start.
  // Überschreibungsreihenfolge (aufsteigend):
  //   1. Diese Datei
  //   2. appsettings.{Environment}.json
  //   3. Environment-Variablen (Doppelunterstrich als Trenner, z.B. KnowHowToAI__Retrieval__MaximumPageSize=200)
  //   4. Kommandozeilenargumente
  //
  // Secrets wie Connection Strings stehen NIE hier. Sie kommen aus:
  //   - Environment-Variablen (z.B. ConnectionStrings__KnowHowToAI=Server=...;Database=...)
  //   - dotnet user-secrets (Entwicklungsumgebung)
  //   - Deployment-Secretstore (Produktion)
  "KnowHowToAI": {
    "Validation": {
      // NodeTooLarge ab dieser normalisierten UTF-8-Größe (gültig: 512..1048576)
      "ContentSizeWarningBytes": 4096,
      // TooManyChildren ab dieser direkten Kindknoten-Anzahl (gültig: 2..10000)
      "ChildCountWarning": 25,
      // HierarchyTooDeep ab dieser globalen Node-Tiefe (gültig: 2..256)
      "HierarchyDepthWarning": 8,
      // Heuristische Warnung für alleinstehende Ersatztitel aktivieren
      "PossibleEmbeddedHeadingWarning": true
    },
    "Retrieval": {
      // Standardseite für Listen, z.B. list_children (gültig: 1..MaximumPageSize)
      "DefaultPageSize": 20,
      // Größte akzeptierte Listenseite (gültig: 1..1000)
      "MaximumPageSize": 100,
      // Standardseite für Suchergebnisse (gültig: 1..SearchMaximumPageSize)
      "SearchPageSize": 10,
      // Größte akzeptierte Such-Seite (gültig: 1..500)
      "SearchMaximumPageSize": 50,
      // Maximale Länge eines Suchsnippets in Zeichen (gültig: 50..4000)
      "SnippetMaximumCharacters": 300
    },
    "Storage": {
      // SQL-Command-Timeout in Sekunden (gültig: 1..600)
      "CommandTimeoutSeconds": 30
    },
    "Migrations": {
      // Warten auf den Migration-Lock in Sekunden (gültig: 1..600)
      "LockTimeoutSeconds": 60,
      // Ausstehende Migrationen beim Serverstart automatisch anwenden
      "ApplyOnStartup": true
    }
  }
}
