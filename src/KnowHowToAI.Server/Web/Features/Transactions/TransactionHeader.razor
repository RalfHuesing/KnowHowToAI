@namespace KnowHowToAI.Server.Web.Features.Transactions
@using KnowHowToAI.Core.Domain.Versioning

<header class="transaction-header" data-testid="transaction-header">
    <div class="transaction-header__main">
        <div class="transaction-header__title-row">
            <h2 class="transaction-header__title" data-testid="tx-title">
                @(string.IsNullOrWhiteSpace(Transaction.Purpose) ? "Ohne Zweckangabe" : Transaction.Purpose)
            </h2>
            <span class="badge badge-state badge-state--@Transaction.State.ToString().ToLowerInvariant()" data-testid="tx-state">
                @Transaction.State
            </span>
            @if (IsOlderThan7Days)
            {
                <span class="badge badge-warning" data-testid="tx-age-warning">Älter als 7 Tage</span>
            }
        </div>
    </div>

    <p class="transaction-header__context">
        Prüfen Sie die Änderungen, bevor Sie die Transaction abschließen.
    </p>

    <details class="transaction-header__technical" data-testid="tx-technical-details">
        <summary>Technische Details</summary>
        <p class="transaction-header__id" data-testid="tx-id">ID: @Transaction.TransactionId</p>
        <dl class="transaction-header__meta" data-testid="tx-meta">
            <div class="transaction-header__meta-item">
                <dt>Akteur:</dt>
                <dd data-testid="tx-actor">@(Transaction.Actor ?? "Nicht angegeben")</dd>
            </div>
            <div class="transaction-header__meta-item">
                <dt>Client:</dt>
                <dd data-testid="tx-client">@(Transaction.Client ?? "Nicht angegeben")</dd>
            </div>
            <div class="transaction-header__meta-item">
                <dt>Erstellt am:</dt>
                <dd data-volatile="" title="@Transaction.CreatedAtUtc.ToString("u")" data-testid="tx-created-at">
                    @Transaction.CreatedAtUtc.ToString("g")
                </dd>
            </div>
            <div class="transaction-header__meta-item">
                <dt>Basis-Snapshot:</dt>
                <dd data-testid="tx-base-snapshot">@Transaction.BaseSnapshotId</dd>
            </div>
            <div class="transaction-header__meta-item">
                <dt>Arbeits-Snapshot:</dt>
                <dd data-testid="tx-working-snapshot">@Transaction.WorkingSnapshotId</dd>
            </div>
            <div class="transaction-header__meta-item">
                <dt>Änderungsversion:</dt>
                <dd data-testid="tx-change-version">@Transaction.ChangeVersion</dd>
            </div>
        </dl>
    </details>
</header>
