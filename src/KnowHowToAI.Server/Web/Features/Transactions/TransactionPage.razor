@page "/transactions/{TransactionId:guid}"
@namespace KnowHowToAI.Server.Web.Features.Transactions
@using KnowHowToAI.Core.Domain.Common
@using Microsoft.AspNetCore.Components.Web
@using KnowHowToAI.Server.Web.Components.Shared.Dialogs
@using KnowHowToAI.Server.Web.Components.Shared.Feedback
@using KnowHowToAI.Server.Web.Features.History

<div class="transaction-page" data-testid="transaction-page">
    @if (_isLoading)
    {
        <p class="loading-state" role="status">Lade Transaction...</p>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="transaction-error" role="alert" data-testid="transaction-error">
            <InlineAlert Kind="AlertKind.Fehler" Message="@_errorMessage" />
            <div class="error-actions">
                <a href="/transactions" class="btn btn-secondary" data-testid="tx-back-link">Zur Übersicht</a>
            </div>
        </div>
    }
    else if (_transaction is not null)
    {
        <TransactionHeader Transaction="@_transaction"
                           IsOlderThan7Days="@(_transaction.CreatedAtUtc <= Clock.UtcNow.AddDays(-7))" />

        <TransactionValidation Transaction="@_transaction" />

        <TransactionDiff Transaction="@_transaction" />

        @if (_snapshotConflict is not null)
        {
            <section class="snapshot-conflict" aria-labelledby="snapshot-conflict-heading" data-testid="snapshot-conflict">
                <h2 id="snapshot-conflict-heading">Commit-Konflikt auflösen</h2>
                <div role="alert" data-testid="snapshot-conflict-explanation">
                    <InlineAlert Kind="AlertKind.Fehler" Message="Der Commit wurde nicht ausgeführt. Ihre Änderungen wurden nicht übernommen." />
                    <p>
                        Diese Transaction basiert auf Base-Snapshot @_snapshotConflict.BaseSnapshotId.
                        Der Current Snapshot @_snapshotConflict.CurrentSnapshotId ist inzwischen maßgeblich.
                    </p>
                    <p>
                        Vergleichen Sie die Snapshots und starten Sie anschließend eine neue Transaction.
                        Änderungen werden nicht automatisch zusammengeführt oder kopiert.
                    </p>
                </div>

                <SnapshotDiffPanel BaseSnapshotId="@_snapshotConflict.BaseSnapshotId"
                                   TargetSnapshotId="@_snapshotConflict.CurrentSnapshotId" />

                <div class="snapshot-conflict__actions">
                    <button type="button" class="btn btn-primary" @onclick="StartManualReapplyAsync"
                            disabled="@(!CanStartManualReapply)" data-testid="snapshot-conflict-start-reapply">
                        @(_isStartingManualReapply ? "Neue Transaction wird gestartet..." : "Neue Transaction für manuelles Reapply beginnen")
                    </button>
                    <p class="snapshot-conflict__hint">
                        Die konfliktbehaftete Transaction bleibt erhalten, bis Sie sie ausdrücklich verwerfen.
                    </p>
                </div>
            </section>
        }

        <div class="transaction-page__actions" data-testid="transaction-page-actions">
            @if (!string.IsNullOrWhiteSpace(_completionError))
            {
                <div class="transaction-page__completion-error" role="alert" data-testid="transaction-completion-error">
                    <InlineAlert Kind="AlertKind.Fehler" Message="@_completionError" />
                </div>
            }
            @if (_transaction.State != TransactionState.Open)
            {
                <p role="status" data-testid="transaction-completion-unavailable">
                    Diese Transaction ist bereits abgeschlossen und kann nicht erneut committed oder verworfen werden.
                </p>
            }
            <button type="button" class="btn btn-primary" @onclick="OpenCommitDialogAsync"
                    disabled="@(!CanCommit)" data-testid="commit-transaction-button">
                Commit
            </button>
            <button type="button" class="btn btn-secondary" @onclick="OpenDiscardDialogAsync"
                    disabled="@(!CanDiscard)" data-testid="discard-transaction-button">
                Verwerfen
            </button>
            <a href="@KnowledgeUrl" class="btn btn-primary" data-testid="tx-open-knowledge-link">
                Im Wissensbaum öffnen
            </a>
            <a href="/transactions" class="btn btn-secondary" data-testid="tx-back-link">
                Zur Übersicht
            </a>
        </div>
    }
</div>

<ConfirmationDialog @ref="_commitDialog"
                    Title="Transaction committen"
                    Message="Der Working Snapshot wird zum neuen Current Snapshot. Dieser Schritt kann nicht rückgängig gemacht werden."
                    ConfirmText="Commit ausführen"
                    InputLabel="Commit-Nachricht (optional)"
                    OnConfirmWithInput="CommitAsync"
                    OnCancel="DismissDialogAsync" />

<ConfirmationDialog @ref="_discardDialog"
                    Title="Transaction verwerfen"
                    Message="Alle Änderungen im Working Snapshot werden verworfen. Der aktuelle Snapshot bleibt unverändert."
                    ConfirmText="Transaction verwerfen"
                    IsDestructive="true"
                    OnConfirm="DiscardAsync"
                    OnCancel="DismissDialogAsync" />
