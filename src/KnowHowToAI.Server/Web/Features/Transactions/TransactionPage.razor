@page "/transactions/{TransactionId:guid}"
@namespace KnowHowToAI.Server.Web.Features.Transactions
@using KnowHowToAI.Server.Web.Components.Shared
@using KnowHowToAI.Core.Domain.Common
@using Microsoft.AspNetCore.Components.Web
@using KnowHowToAI.Server.Web.Components.Shared.Dialogs
@using KnowHowToAI.Server.Web.Components.Shared.Feedback
@using KnowHowToAI.Server.Web.Features.History

<PageFrame Title="@TransactionPageTitle" Class="transaction-page" data-testid="transaction-page">
    @if (_isLoading)
    {
        <p class="loading-state" role="status">Lade Transaction...</p>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="transaction-error" role="alert" data-testid="transaction-error">
            <InlineAlert Kind="AlertKind.Fehler" Message="@_errorMessage" />
            <div class="error-actions">
                <a href="/transactions" class="btn btn-secondary" data-testid="tx-back-link">Zur Übersicht</a>
            </div>
        </div>
    }
    else if (_transaction is not null)
    {
        <TransactionHeader Transaction="@_transaction"
                           IsOlderThan7Days="@(_transaction.CreatedAtUtc <= Clock.UtcNow.AddDays(-7))" />

        <section class="transaction-next-steps" aria-labelledby="transaction-next-steps-heading" data-testid="transaction-next-steps">
            <h2 id="transaction-next-steps-heading">Weiterarbeiten</h2>
            <p class="readable">Öffnen Sie den Wissensbaum in dieser Arbeitskopie. Die Zielgruppe bleibt erhalten; pflegen Sie sie separat oder kehren Sie zur Übersicht zurück.</p>
            <div class="transaction-page__actions action-group">
                <a href="@KnowledgeUrl" class="btn btn-primary" data-testid="tx-open-knowledge-link">
                    Im Wissensbaum öffnen
                </a>
                <a href="/audiences?transactionId=@TransactionId" class="btn btn-secondary" data-testid="tx-open-audiences-link">
                    Zielgruppen pflegen
                </a>
                <a href="/transactions" class="btn btn-secondary" data-testid="tx-back-link">
                    Zur Übersicht
                </a>
            </div>
        </section>

        <section class="transaction-workflow" aria-labelledby="transaction-workflow-heading" data-testid="transaction-workflow">
            <div class="transaction-workflow__intro">
                <p class="transaction-workflow__eyebrow">Arbeitsablauf</p>
                <h2 id="transaction-workflow-heading">Prüfen und abschließen</h2>
                <p class="readable">Arbeiten Sie die Schritte in dieser Reihenfolge ab: zuerst validieren, danach committen oder verwerfen.</p>
            </div>

            <div class="transaction-workflow__step" data-testid="transaction-validation-step">
                <span class="transaction-workflow__step-number" aria-hidden="true">1</span>
                <div>
                    <h3>Validieren</h3>
                    <p>Prüfen Sie den aktuellen Working Snapshot auf blockierende Fehler.</p>
                </div>
            </div>
            <TransactionValidation Transaction="@_transaction" />

            <TransactionCompletionPanel @key="_transaction.TransactionId" Transaction="@_transaction" />
        </section>

        <TransactionDiff Transaction="@_transaction" />
    }
</PageFrame>
