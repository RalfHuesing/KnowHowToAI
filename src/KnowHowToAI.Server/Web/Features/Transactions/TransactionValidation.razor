@namespace KnowHowToAI.Server.Web.Features.Transactions
@using KnowHowToAI.Core.Domain.Common
@using Microsoft.AspNetCore.Components.Web

<section class="transaction-validation" aria-labelledby="transaction-validation-heading" data-testid="transaction-validation">
    <div class="transaction-validation__header">
        <div>
            <h2 id="transaction-validation-heading">Entwurf prüfen</h2>
            <p>Prüft den aktuellen Arbeitsstand serverseitig. Fehler müssen vor der Übernahme behoben werden.</p>
        </div>
        <button type="button" class="btn btn-primary" @onclick="ValidateAsync"
                disabled="@(Transaction.State != TransactionState.Open || _isValidating)"
                data-testid="validate-transaction-button">
            @(_isValidating ? "Validierung läuft..." : "Entwurf validieren")
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <p class="transaction-validation__error" role="alert" data-testid="validation-request-error">@_errorMessage</p>
    }
    else if (_result is null)
    {
        <p class="transaction-validation__notice" role="status" data-testid="validation-pending">
            Noch nicht validiert. Führen Sie die Validierung aus, bevor Sie die Änderungen übernehmen.
        </p>
    }
    else if (ResultsAreStale)
    {
        <p class="transaction-validation__stale" role="status" data-testid="validation-results-stale">
            Diese Befunde beziehen sich auf Änderungsversion @_result.ChangeVersion. Der Entwurf wurde danach geändert; bitte erneut validieren.
        </p>
    }
    else if (_result.IsValid)
    {
        <p class="transaction-validation__success" role="status" data-testid="validation-valid">
            Keine blockierenden Fehler gefunden. Warnungen und Strukturhinweise sollten Sie vor der Übernahme prüfen.
        </p>
    }
    else
    {
        <p class="transaction-validation__error" role="alert" data-testid="validation-invalid">
            @_result.Errors.Count Fehler blockieren die Übernahme. Beheben Sie die folgenden Befunde und validieren Sie erneut.
        </p>
    }

    @if (_result is { } result)
    {
        @if (result.Errors.Count > 0)
        {
            <section class="transaction-validation__group transaction-validation__group--error" aria-labelledby="validation-errors-heading" data-testid="validation-errors">
                <h3 id="validation-errors-heading">Fehler (@result.Errors.Count)</h3>
                <ul>
                    @foreach (var finding in result.Errors)
                    {
                        <li data-testid="validation-error-@finding.Code">
                            <strong>@finding.Code</strong>: @finding.Message
                            @if (finding.NodeId is { } nodeId)
                            {
                                <a href="@GetNodeUrl(nodeId)" data-testid="validation-error-node-@nodeId">Betroffenen Node öffnen</a>
                            }
                        </li>
                    }
                </ul>
            </section>
        }

        @if (result.Warnings.Count > 0)
        {
            <section class="transaction-validation__group transaction-validation__group--warning" aria-labelledby="validation-warnings-heading" data-testid="validation-warnings">
                <h3 id="validation-warnings-heading">Warnungen (@result.Warnings.Count)</h3>
                <p>Warnungen blockieren die Übernahme nicht, weisen aber auf prüfungsbedürftige Qualität hin.</p>
                <ul>
                    @foreach (var finding in result.Warnings)
                    {
                        <li data-testid="validation-warning-@finding.Code">
                            <strong>@finding.Code</strong>: @finding.Message
                            @if (finding.NodeId is { } nodeId)
                            {
                                <a href="@GetNodeUrl(nodeId)" data-testid="validation-warning-node-@nodeId">Betroffenen Node öffnen</a>
                            }
                        </li>
                    }
                </ul>
            </section>
        }

        @if (result.StaleContents.Count > 0)
        {
            <section class="transaction-validation__group transaction-validation__group--stale" aria-labelledby="validation-stale-heading" data-testid="validation-stale-contents">
                <h3 id="validation-stale-heading">Veraltete abgeleitete Inhalte (@result.StaleContents.Count)</h3>
                <p>Aktualisieren Sie die Quellen oder erzeugen Sie den abgeleiteten Inhalt neu.</p>
                <ul>
                    @foreach (var content in result.StaleContents)
                    {
                        <li data-testid="validation-stale-node-@content.NodeId">
                            Zielgruppe @content.AudienceId, Revision @content.ContentRevisionId
                            <a href="@GetNodeUrl(content.NodeId)" data-testid="validation-stale-node-link-@content.NodeId">Node öffnen</a>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (result.RefactoringCandidates.Count > 0)
        {
            <section class="transaction-validation__group" aria-labelledby="validation-refactoring-heading" data-testid="validation-refactoring-candidates">
                <h3 id="validation-refactoring-heading">Strukturpflege empfohlen (@result.RefactoringCandidates.Count)</h3>
                <ul>
                    @foreach (var candidate in result.RefactoringCandidates)
                    {
                        <li data-testid="validation-refactoring-node-@candidate.NodeId">
                            @string.Join(", ", candidate.ReasonCodes)
                            <a href="@GetNodeUrl(candidate.NodeId)" data-testid="validation-refactoring-node-link-@candidate.NodeId">Node strukturieren</a>
                        </li>
                    }
                </ul>
            </section>
        }
    }
</section>
