@namespace KnowHowToAI.Server.Web.Features.History
@using KnowHowToAI.Server.Web.Components.Shared.Feedback
@using Microsoft.AspNetCore.Components.Web

<section class="release-panel history-page__section" aria-labelledby="releases-heading">
    <h2 id="releases-heading">Releases</h2>
    <button type="button" class="history-page__next" @onclick="OpenCreateReleaseDialogAsync" disabled="@(Snapshots.Count == 0)" data-testid="create-release-button">Release anlegen</button>
    @if (_createdRelease is not null)
    {
        <section class="history-page__release-result" role="status" data-testid="release-created">
            <p>Release „@_createdRelease.Name“ für Snapshot @_createdRelease.SnapshotId wurde angelegt.</p>
            @if (_createdRelease.Findings.Count == 0)
            {
                <p>Für den Snapshot liegen keine Qualitätsbefunde vor.</p>
            }
            else
            {
                <p>Der Release wurde trotz folgender Qualitätsbefunde angelegt:</p>
                <ul data-testid="release-created-findings">
                    @foreach (var finding in _createdRelease.Findings)
                    {
                        <li>@finding</li>
                    }
                </ul>
            }
            <button type="button" class="btn btn-secondary" @onclick="() => NavigateToRelease(_createdRelease.ReleaseId)" data-testid="release-created-navigate">Release öffnen</button>
        </section>
    }
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div role="alert" data-testid="release-list-error"><InlineAlert Kind="AlertKind.Fehler" Message="@_errorMessage" /></div>
    }
    else if (_page is null || _page.Items.Count == 0)
    {
        <p role="status" data-testid="release-list-empty">Es sind noch keine Releases benannt.</p>
    }
    else
    {
        <ol class="history-page__list" data-testid="release-list">
            @foreach (var release in _page.Items)
            {
                <li>
                    <button type="button" class="history-page__item" @onclick="() => NavigateToRelease(release.ReleaseId)" data-testid="release-select-@release.ReleaseId">
                        <span class="history-page__item-title">@release.Name</span>
                        <span class="history-page__metadata" title="@FormatUtc(release.ReleasedAtUtc)">Snapshot @release.SnapshotId · Release @FormatTimestamp(release.ReleasedAtUtc)</span>
                        @if (!string.IsNullOrWhiteSpace(release.Description))
                        {
                            <span class="history-page__metadata">@release.Description</span>
                        }
                    </button>
                </li>
            }
        </ol>
        @if (!string.IsNullOrEmpty(_page.NextCursor))
        {
            <button type="button" class="history-page__next" @onclick="LoadNextPageAsync" data-testid="release-list-next">Weitere Releases</button>
        }
    }
    <CreateReleaseDialog @ref="_createReleaseDialog" Snapshots="@Snapshots" OnCreated="ReleaseCreatedAsync" />
</section>
