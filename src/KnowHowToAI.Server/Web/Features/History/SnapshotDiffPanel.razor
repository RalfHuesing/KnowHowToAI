@namespace KnowHowToAI.Server.Web.Features.History
@using KnowHowToAI.Server.Web.Components.Shared.Feedback
@using Microsoft.AspNetCore.Components.Web

<section class="snapshot-diff" aria-labelledby="snapshot-diff-heading" data-testid="snapshot-diff">
    <h2 id="snapshot-diff-heading">Snapshot-Diff</h2>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div role="alert" data-testid="snapshot-diff-error">
            <InlineAlert Kind="AlertKind.Fehler" Message="@ErrorMessage" />
        </div>
    }
    else if (BaseSnapshotId is null || TargetSnapshotId is null)
    {
        <p role="status" data-testid="snapshot-diff-selection-required">Wählen Sie einen Ausgangs- und einen Ziel-Snapshot für den Vergleich.</p>
    }
    else if (IsLoading)
    {
        <p role="status" data-testid="snapshot-diff-loading">Snapshot-Diff wird geladen …</p>
    }
    else if (ViewModel is null || ViewModel.Entries.Count == 0)
    {
        <p role="status" data-testid="snapshot-diff-empty">
            @if (NodeFilterId.HasValue)
            {
                @:Für diesen Knoten bestehen zwischen den ausgewählten Snapshots keine Änderungen.
            }
            else
            {
                @:Zwischen den ausgewählten Snapshots bestehen keine Änderungen.
            }
        </p>
    }
    else
    {
        <p class="snapshot-diff__summary" data-testid="snapshot-diff-summary">
            Snapshot @ViewModel.BaseSnapshotId → Snapshot @ViewModel.TargetSnapshotId: @ViewModel.TotalCount Änderung(en)
            @if (NodeFilterId.HasValue)
            {
                @:(gefiltert auf Knoten @NodeFilterId.Value)
            }
        </p>
        <ol class="snapshot-diff__list" data-testid="snapshot-diff-list">
            @foreach (var entry in ViewModel.Entries)
            {
                <li class="snapshot-diff__entry" data-testid="snapshot-diff-entry-@entry.EntityType-@entry.PrimaryId">
                    <span class="snapshot-diff__kind snapshot-diff__kind--@entry.Kind.ToLowerInvariant()">@MapKind(entry.Kind)</span>
                    <div>
                        <strong>@MapEntityType(entry.EntityType)</strong>
                        <span class="snapshot-diff__ids">@entry.PrimaryId@if (!string.IsNullOrWhiteSpace(entry.SecondaryId)) { <text> · @entry.SecondaryId</text> }</span>
                        @if (!string.IsNullOrWhiteSpace(entry.Detail))
                        {
                            <p class="snapshot-diff__detail">@entry.Detail</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(entry.Before))
                        {
                            <p class="snapshot-diff__before"><span>Vorher</span> @entry.Before</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(entry.After))
                        {
                            <p class="snapshot-diff__after"><span>Nachher</span> @entry.After</p>
                        }
                    </div>
                </li>
            }
        </ol>
        @if (!string.IsNullOrEmpty(ViewModel.NextCursor))
        {
            <button type="button" class="history-page__next" @onclick="@(() => LoadNext.InvokeAsync())" data-testid="snapshot-diff-next">Weitere Änderungen</button>
        }
    }
</section>
