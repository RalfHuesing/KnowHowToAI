@using KnowHowToAI.Server.Web.Components.Shared.Dialogs
@using Microsoft.AspNetCore.Components.Web
@namespace KnowHowToAI.Server.Web.Features.History

<AppDialog @ref="_dialog"
           Title="Release anlegen"
           OnClosed="DismissAsync">
    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div role="alert" data-testid="create-release-error">@_errorMessage</div>
    }
    <div class="create-release-dialog__field">
        <label for="@_snapshotId">Committed Snapshot</label>
        <select id="@_snapshotId" value="@_selectedSnapshotId" @onchange="UpdateSelectedSnapshot" disabled="@_isSubmitting" data-testid="create-release-snapshot">
            <option value="">Snapshot auswählen</option>
            @foreach (var snapshot in CommittedSnapshots)
            {
                <option value="@snapshot.SnapshotId">Snapshot @snapshot.SnapshotId</option>
            }
        </select>
    </div>
    <div class="create-release-dialog__field">
        <label for="@_nameId">Release-Name</label>
        <input id="@_nameId" value="@_name" @onchange="UpdateName" disabled="@_isSubmitting" data-testid="create-release-name" />
    </div>
    <div class="create-release-dialog__field">
        <label for="@_descriptionId">Beschreibung (optional)</label>
        <textarea id="@_descriptionId" value="@_description" @onchange="UpdateDescription" disabled="@_isSubmitting" rows="3" data-testid="create-release-description"></textarea>
    </div>
    <div class="create-release-dialog__actions action-group">
        <button type="button" class="btn btn-secondary" disabled="@_isSubmitting" @onclick="CancelAsync">Abbrechen</button>
        <button type="button" class="btn btn-primary" disabled="@_isSubmitting" @onclick="CreateAsync" data-testid="create-release-submit">Release anlegen</button>
    </div>
</AppDialog>
