@page "/history"
@using KnowHowToAI.Server.Web.Components.Shared.Feedback
@using Microsoft.AspNetCore.Components.Web
@namespace KnowHowToAI.Server.Web.Features.History

<PageTitle>Historie und Releases – KnowHowToAI</PageTitle>

<section class="history-page" data-testid="history-page">
    <header class="history-page__header">
        <h1>Historie und Releases</h1>
        <p>Committed Snapshots und Releases sind unveränderliche Wissensstände.</p>
    </header>

    <section class="history-page__notice" aria-label="Abgrenzung von Working Transactions" data-testid="history-working-separation">
        <InlineAlert Kind="AlertKind.Info" Message="Working Transactions gehören nicht zur Historie und werden separat im Transaction-Arbeitsbereich bearbeitet." />
    </section>

    <section class="history-page__comparison" aria-labelledby="history-comparison-heading" data-testid="history-comparison-context">
        <header class="history-page__comparison-header">
            <div>
                <p class="history-page__eyebrow">Arbeitsabschnitt</p>
                <h2 id="history-comparison-heading">Snapshots vergleichen</h2>
                <p>Wählen Sie einen Ausgangs- und einen Zielstand. Das Ergebnis zeigt nur die Unterschiede zwischen diesen unveränderlichen Wissensständen.</p>
            </div>
            <div class="history-page__selection-summary" aria-live="polite" data-testid="history-selection-status">
                <div class="history-page__selection">
                    <span class="history-page__selection-label">Ausgang</span>
                    <strong>@FormatSelection(_baseSnapshotId)</strong>
                    <span class="history-page__selection-hint">Älterer Wissensstand</span>
                </div>
                <div class="history-page__selection">
                    <span class="history-page__selection-label">Ziel</span>
                    <strong>@FormatSelection(_targetSnapshotId)</strong>
                    <span class="history-page__selection-hint">Zu vergleichender Wissensstand</span>
                </div>
            </div>
        </header>

        <div class="history-page__comparison-grid">
            <SnapshotList AudienceId="@QueryAudienceId"
                          SelectedBaseSnapshotId="@_baseSnapshotId"
                          SelectedTargetSnapshotId="@_targetSnapshotId"
                          OnSnapshotsChanged="SnapshotsChangedAsync"
                          OnBaseSnapshotSelected="SelectBaseSnapshotAsync"
                          OnTargetSnapshotSelected="SelectTargetSnapshotAsync" />

            <SnapshotDiffPanel BaseSnapshotId="@_baseSnapshotId"
                               TargetSnapshotId="@_targetSnapshotId"
                               NodeFilterId="@_nodeFilterId"
                               InitialErrorMessage="@_comparisonErrorMessage" />
        </div>
    </section>

    <ReleasePanel Snapshots="@_snapshots" AudienceId="@QueryAudienceId" />
</section>
