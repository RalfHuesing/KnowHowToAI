@using KnowHowToAI.Core.Domain.Common
@using Microsoft.AspNetCore.Components.Web
@namespace KnowHowToAI.Server.Web.Features.Content

<section class="content-editor @(IsReadOnly ? "content-editor--readonly" : string.Empty)"
         aria-label="Markdown-Inhalt"
         data-testid="content-editor"
         data-readonly="@IsReadOnly">
    <div class="content-editor__mode-switch" role="group" aria-label="Editor-Modus">
        <button type="button"
                class="btn @(IsSourceMode ? "btn-secondary" : "btn-primary")"
                data-testid="content-editor-mode-wysiwyg"
                aria-pressed="@(!IsSourceMode)"
                disabled="@(!IsSourceMode)"
                @onclick="ShowWysiwygAsync">
            WYSIWYG
        </button>
        <button type="button"
                class="btn @(IsSourceMode ? "btn-primary" : "btn-secondary")"
                data-testid="content-editor-mode-source"
                aria-pressed="@IsSourceMode"
                disabled="@IsSourceMode"
                @onclick="ShowSourceAsync">
            Markdown-Quelle
        </button>
    </div>

    @if (IsSourceMode)
    {
        <label class="content-editor__source-label" for="content-editor-source">Markdown-Quelle</label>
        <textarea id="content-editor-source"
                  class="content-editor__source"
                  data-testid="content-editor-source"
                  readonly="@IsReadOnly"
                  @ref="_sourceElement"
                  @bind="SourceMarkdown"
                  @bind:event="oninput"></textarea>
    }
    else
    {
        <div class="content-editor__surface"
             @ref="_editorElement"
             data-testid="content-editor-surface"></div>
    }

    @if (_errorMessage is not null)
    {
        <div class="content-editor__error" role="alert" data-testid="content-editor-error">
            @_errorMessage
        </div>
    }

    @if (!IsReadOnly)
    {
        <div class="content-editor__actions">
            <span class="content-editor__status" role="status" aria-live="polite">
                @(_isSaving ? "Wird gespeichert…" : _pasteWasReduced ? "Eingefügter Inhalt wurde aus Sicherheitsgründen reduziert." : WorkspaceState.IsDirty ? "Ungespeicherte Änderungen" : "Gespeichert")
            </span>
            <button type="button"
                    class="btn btn-primary"
                    data-testid="content-editor-save"
                    disabled="@(_isSaving || !TransactionId.HasValue)"
                    @onclick="SaveAsync">
                Speichern
            </button>
        </div>
    }
</section>
