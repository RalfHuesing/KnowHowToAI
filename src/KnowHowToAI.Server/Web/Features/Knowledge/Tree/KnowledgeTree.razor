@using Microsoft.AspNetCore.Components.Web
@using KnowHowToAI.Server.Web.Features.Knowledge.Components
@namespace KnowHowToAI.Server.Web.Features.Knowledge.Tree

<div class="tree-container" data-testid="knowledge-tree-container">
    @if (!string.IsNullOrEmpty(TreeWorkspace.StatusMessage))
    {
        <div class="tree-status" role="status" aria-live="polite" data-testid="tree-status">
            @TreeWorkspace.StatusMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(TreeWorkspace.RootError))
    {
        <div class="tree-error" role="alert" data-testid="tree-error">
            @TreeWorkspace.RootError
        </div>
    }

    @if (!string.IsNullOrEmpty(_moveErrorMessage))
    {
        <div class="tree-error" role="alert" data-testid="tree-move-error">@_moveErrorMessage</div>
    }

    @if (TreeWorkspace.IsLoading)
    {
        <div class="tree-loading" role="status" data-testid="tree-loading">
            <span class="tree-spinner" aria-hidden="true">⟳</span>
            <span>Lade Wissensbaum...</span>
        </div>
    }
    else if (TreeWorkspace.VisualRootNode is null && string.IsNullOrEmpty(TreeWorkspace.RootError))
    {
        <div class="tree-empty" data-testid="tree-empty">
            Keine Wissensknoten vorhanden.
        </div>
    }
    else if (TreeWorkspace.VisualRootNode is not null)
    {
        <ul class="knowledge-tree"
             aria-label="Wissensbaum"
             data-testid="knowledge-tree"
             @ref="_treeElement">
            @RenderNode(TreeWorkspace.VisualRootNode)
        </ul>
    }
</div>

@code {
    private RenderFragment RenderNode(KnowledgeTreeNodeViewModel node) => __builder =>
    {
        var statusDescriptionId = $"tree-status-{node.NodeId}";

        <li class="tree-node-wrapper" @key="node.NodeId">
            <div class="tree-node-row">
                @if (node.HasChildren)
                {
                    <button type="button"
                            class="tree-toggle-btn @(node.IsExpanded ? "is-expanded" : "")"
                            aria-label="@(node.IsExpanded ? $"„{node.Title}“ einklappen" : $"„{node.Title}“ aufklappen")"
                            aria-expanded="@(node.IsExpanded ? "true" : "false")"
                            data-testid="@($"tree-toggle-{node.NodeId}")"
                            @onclick="() => HandleToggleExpandAsync(node)">
                        <span class="toggle-icon" aria-hidden="true">@(node.IsExpanded ? "▼" : "▶")</span>
                    </button>
                }
                else
                {
                    <span class="tree-toggle-placeholder" aria-hidden="true"></span>
                }

                <button type="button"
                 id="@($"tree-node-{node.NodeId}")"
                 class="tree-node tree-node-select @(node.IsSelected ? "is-selected" : "") @(node.IsLoading ? "is-loading" : "")"
                 aria-pressed="@(node.IsSelected ? "true" : "false")"
                 aria-describedby="@statusDescriptionId"
                 data-testid="@($"tree-node-{node.NodeId}")"
                 data-nodeid="@node.NodeId">
                <span class="tree-node-title" data-testid="@($"tree-title-{node.NodeId}")">@node.Title</span>

                <span id="@statusDescriptionId" hidden>
                    Status: @node.Summary.Availability; Aktualität: @node.Summary.Freshness@(node.Summary.Findings is { Count: > 0 } ? "; Warnung vorhanden" : string.Empty)
                </span>

                <span class="tree-node-badges" aria-hidden="true">
                    @if (string.Equals(node.Summary.Availability, "Explicit", StringComparison.Ordinal))
                    {
                        <span class="tree-node-badge tree-node-badge--explicit" data-testid="@($"tree-badge-explicit-{node.NodeId}")">
                            <span aria-hidden="true">●</span> Eigener Inhalt
                        </span>
                    }
                    else if (string.Equals(node.Summary.Availability, "Fallback", StringComparison.Ordinal))
                    {
                        <span class="tree-node-badge tree-node-badge--fallback" data-testid="@($"tree-badge-fallback-{node.NodeId}")">
                            <span aria-hidden="true">↪</span> Fallback
                        </span>
                    }
                    else
                    {
                        <span class="tree-node-badge tree-node-badge--none" data-testid="@($"tree-badge-none-{node.NodeId}")">
                            <span aria-hidden="true">○</span> Kein Inhalt
                        </span>
                    }

                    @if (string.Equals(node.Summary.Freshness, "Stale", StringComparison.Ordinal))
                    {
                        <span class="tree-node-badge tree-node-badge--stale" data-testid="@($"tree-badge-stale-{node.NodeId}")">
                            <span aria-hidden="true">◷</span> Veraltet
                        </span>
                    }

                    @if (node.Summary.Findings is { Count: > 0 })
                    {
                        <span class="tree-node-badge tree-node-badge--finding"
                              title="@string.Join(", ", node.Summary.Findings)"
                              data-testid="@($"tree-badge-findings-{node.NodeId}")">
                            <span aria-hidden="true">⚠</span> Warnung
                        </span>
                    }
                </span>

                @if (node.IsLoading)
                {
                    <span class="tree-node-spinner" role="status" aria-label="Wird geladen...">⟳</span>
                }
                @if (!string.IsNullOrEmpty(node.Error))
                {
                    <span class="tree-node-error" role="alert" data-testid="@($"tree-node-error-{node.NodeId}")">@node.Error</span>
                }
                </button>

                @if (CanMove)
                {
                    <span class="tree-node-actions">
                        <button type="button" class="tree-action-btn" aria-label="Unterknoten unter @node.Title anlegen"
                                data-testid="create-child-@node.NodeId" @onclick:stopPropagation="true"
                                @onclick="() => BeginCreateChild(node.NodeId)">Unterknoten anlegen</button>
                    </span>
                }

            </div>

            @if (_creatingChildNodeId == node.NodeId)
            {
                <RootNodeEditor ParentNodeId="@node.NodeId" ParentTitle="@node.Title"
                                OnMutationSucceeded="HandleNodeMutationSucceededAsync" />
            }

            @if (node.HasChildren && node.IsExpanded)
            {
                <ul class="tree-children-group" aria-label="@($"Unterknoten von {node.Title}")">
                    @if (!node.IsChildrenPageLoaded)
                    {
                        <li class="tree-paging-row">
                            <button type="button"
                                    class="tree-page-btn"
                                    data-testid="@($"tree-load-children-{node.NodeId}")"
                                    @onclick="() => TreeWorkspace.ExpandNodeAsync(node.NodeId)">
                                Unterknoten laden
                            </button>
                        </li>
                    }
                    @if (node.HasPreviousPage)
                    {
                        <li class="tree-paging-row">
                            <button type="button"
                                    class="tree-page-btn tree-page-prev"
                                    data-testid="@($"page-prev-{node.NodeId}")"
                                    @onclick="() => HandlePagePreviousAsync(node.NodeId)">
                                ◀ Vorherige 100 Einträge
                            </button>
                        </li>
                    }

                    @foreach (var child in node.Children)
                    {
                        @RenderNode(child)
                    }

                    @if (node.HasNextPage)
                    {
                        <li class="tree-paging-row">
                            <button type="button"
                                    class="tree-page-btn tree-page-next"
                                    data-testid="@($"page-next-{node.NodeId}")"
                                    @onclick="() => HandlePageNextAsync(node.NodeId)">
                                Weitere 100 Einträge ▶
                            </button>
                        </li>
                    }
                </ul>
            }
        </li>
    };
}
