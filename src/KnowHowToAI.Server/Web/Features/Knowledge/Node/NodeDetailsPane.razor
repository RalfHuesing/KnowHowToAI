@namespace KnowHowToAI.Server.Web.Features.Knowledge.Node

<div class="node-details-pane" data-testid="node-details-section">
    <NodeDetailsWorkspace ViewModel="@_viewModel"
                          IsLoading="@_isLoading"
                          ErrorMessage="@_errorMessage"
                          NodeNotFound="@_nodeNotFound"
                          IsWorking="@TransactionId.HasValue"
                          IsWritableReadContext="@IsWritableReadContext"
                          ChangeVersion="@ChangeVersion"
                          LoadedCurrentSnapshotId="@WorkspaceState.LoadedSnapshotId"
                          OnNodeMutationSucceeded="HandleNodeMutationSucceededAsync"
                          OnContentSaved="HandleContentSavedAsync" />
</div>
