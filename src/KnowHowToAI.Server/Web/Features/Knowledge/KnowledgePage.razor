@page "/knowledge"
@using KnowHowToAI.Server.Web.Components.Shared.Feedback
@using KnowHowToAI.Server.Web.Features.Knowledge.Components
@page "/knowledge/{NodeId:guid}"
@using Microsoft.AspNetCore.Components.Web
@namespace KnowHowToAI.Server.Web.Features.Knowledge

<PageTitle>Wissensbasis – KnowHowToAI</PageTitle>

<div class="knowledge-page" data-testid="knowledge-page">
    <header class="knowledge-header">
        <Breadcrumbs Items="TreeWorkspace.Breadcrumbs" OnSelectNode="NavigateToNode" />
    </header>

    @if (_errorMessage is not null)
    {
        <div class="knowledge-error-state" data-testid="knowledge-error" role="alert">
            <InlineAlert Kind="AlertKind.Fehler" Message="@_errorMessage" />
        </div>
    }
    else if (_hasNoRoles)
    {
        <div class="knowledge-empty-roles" data-testid="knowledge-empty-roles" role="status">
            <InlineAlert Kind="AlertKind.Info" Message="Im aktuellen Wissenskontext sind keine Rollen definiert." />
        </div>
    }
    else if (!_isAwaitingRoleSelection)
    {
        <div class="knowledge-layout">
            <aside class="knowledge-sidebar" aria-label="Wissensnavigation" data-testid="knowledge-sidebar">
                <KnowledgeTree OnNodeSelected="NavigateToNode"
                               CanMove="WorkspaceState.HasActiveTransaction"
                               MoveTransactionId="QueryTransactionId"
                               MoveSnapshotId="QuerySnapshotId"
                               MoveReleaseId="QueryReleaseId"
                               OnNodeMutationSucceeded="HandleNodeMutationSucceededAsync" />
            </aside>

            <main class="knowledge-content-pane" aria-label="Knotendetails" data-testid="knowledge-content-pane">
                @if (TreeWorkspace.SelectedNodeId is not null)
                {
                    <NodeDetailsPane NodeId="@TreeWorkspace.SelectedNodeId"
                                     ReadContext="@WorkspaceState.CurrentReadContext"
                                     RoleId="@WorkspaceState.CurrentRoleId"
                                     ChangeVersion="@WorkspaceState.CurrentChangeVersion"
                                     TransactionId="@WorkspaceState.ActiveTransactionId"
                                     QueryTransactionId="@QueryTransactionId"
                                     QuerySnapshotId="@QuerySnapshotId"
                                     QueryReleaseId="@QueryReleaseId"
                                     OnMutationSucceeded="HandleNodeMutationSucceededAsync" />
                }
                else
                {
                    <div class="empty-selection" data-testid="empty-selection">
                        <p>Wählen Sie einen Knoten im Wissensbaum aus, um Details anzuzeigen.</p>
                    </div>
                }
            </main>
        </div>
    }
</div>
