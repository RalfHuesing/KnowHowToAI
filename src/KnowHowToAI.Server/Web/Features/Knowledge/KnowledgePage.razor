@page "/knowledge"
@page "/knowledge/{NodeId:guid}"
@using KnowHowToAI.Server.Web.Components.Shared.Feedback
@using KnowHowToAI.Server.Web.Components.Shared
@using KnowHowToAI.Server.Web.Features.Knowledge.Node
@using KnowHowToAI.Server.Web.Features.Knowledge.Tree
@using KnowHowToAI.Server.Web.Features.Knowledge.Components
@using KnowHowToAI.Server.Web.Components.Layout.Context
@using Microsoft.AspNetCore.Components.Web
@namespace KnowHowToAI.Server.Web.Features.Knowledge

<PageTitle>@CurrentPageTitle – KnowHowToAI</PageTitle>

<PageFrame Title="@CurrentPageTitle" Class="knowledge-page" data-testid="knowledge-page">
    <Breadcrumbs Items="TreeWorkspace.Breadcrumbs" OnSelectNode="NavigateToNode" />

    @if (_errorMessage is not null)
    {
        <div class="knowledge-error-state" data-testid="knowledge-error" role="alert">
            <InlineAlert Kind="AlertKind.Fehler" Message="@_errorMessage" />
        </div>
    }
    else if (_hasNoAudiences)
    {
        <div class="knowledge-empty-audiences" data-testid="knowledge-empty-audiences" role="status">
            <InlineAlert Kind="AlertKind.Info" Message="Im aktuellen Wissenskontext sind keine Zielgruppen definiert." />
        </div>
    }
    else if (!_isAwaitingAudienceSelection)
    {
        @if (WorkspaceState.CurrentAudienceId is { } audienceId)
        {
            <div class="knowledge-audience-context" data-testid="knowledge-audience-context">
                <span>Ausgewählte Zielgruppe</span>
                <strong>@audienceId</strong>
            </div>
        }

        <div class="knowledge-layout">
            <aside class="knowledge-sidebar" aria-label="Wissensnavigation" data-testid="knowledge-sidebar">
                <KnowledgeTree OnNodeSelected="NavigateToNode" CanMove="CanManageTree"
                              OnNodeMutationSucceeded="RefreshKnowledgeTreeAfterMetadataChangeAsync"
                              MoveTransactionId="@QueryTransactionId" />
            </aside>

            <section class="knowledge-content-pane" aria-label="Knotendokument" data-testid="knowledge-content-pane">
                @if (NodeId is not null && WorkspaceState.CurrentAudienceId is not null)
                {
                    <NodeDocument NodeId="@NodeId"
                                     ReadContext="@WorkspaceState.CurrentReadContext"
                                     AudienceId="@WorkspaceState.CurrentAudienceId"
                                     ChangeVersion="@WorkspaceState.CurrentChangeVersion"
                                     TransactionId="@WorkspaceState.ActiveTransactionId"
                                     QueryTransactionId="@QueryTransactionId"
                                     OnMutationSucceeded="RefreshKnowledgeTreeAfterMetadataChangeAsync" />
                }
                else if (TreeWorkspace.VisualRootNode is null
                         && !TreeWorkspace.IsLoading
                         && string.IsNullOrEmpty(TreeWorkspace.RootError))
                {
                    <div class="knowledge-empty-root" data-testid="knowledge-empty-root">
                        <h2>Die Wissensbasis ist noch leer</h2>
                        <p>Der erste Wissensknoten wird beim bestätigten Speichern angelegt.</p>
                        @if (CanManageTree)
                        {
                            <RootNodeEditor OnMutationSucceeded="RefreshKnowledgeTreeAfterMetadataChangeAsync" />
                        }
                    </div>
                }
                else
                {
                    <div class="empty-selection" data-testid="empty-selection">
                        <p>Wählen Sie einen Knoten im Wissensbaum aus, um sein Dokument anzuzeigen.</p>
                    </div>
                }
            </section>
        </div>
    }
    <ContextSelectorDialog />
</PageFrame>
