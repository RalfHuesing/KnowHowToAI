@using KnowHowToAI.Core.Application.Mutations.Nodes
@using KnowHowToAI.Core.Domain.Common
@using KnowHowToAI.Server.Web.Components.Shared.Dialogs
@using KnowHowToAI.Server.Web.Components.Shared.Feedback
@using Microsoft.AspNetCore.Components.Web
@namespace KnowHowToAI.Server.Web.Features.Knowledge.Components

<section class="node-deletion-editor" aria-label="Node löschen" data-testid="node-deletion-editor">
    @if (_errorMessage is not null)
    {
        <InlineAlert Kind="AlertKind.Fehler" Message="@_errorMessage" />
    }

    @if (_preview is null)
    {
        <button type="button" class="btn btn-danger" @onclick="LoadPreviewAsync" disabled="@_isLoading" data-testid="delete-node">
            @(_isLoading ? "Auswirkung wird geladen…" : "Node löschen")
        </button>
    }
    else
    {
        <div class="node-deletion-preview" data-testid="node-deletion-preview">
            <h2 class="node-section-heading">Löschung prüfen</h2>
            <p>Sie löschen global über alle Rollen: <strong data-testid="delete-node-target">@_preview.Title</strong>.</p>
            @if (_preview.IsRoot)
            {
                <InlineAlert Kind="AlertKind.Warnung" Message="Dies ist die Root-Node. Nach ihrer Löschung bleibt die Wissensbasis leer." />
            }
            <dl>
                <dt>Direkte Children</dt>
                <dd data-testid="delete-direct-children">@_preview.DirectChildCount</dd>
                <dt>Nodes im Teilbaum</dt>
                <dd data-testid="delete-subtree-nodes">@_preview.SubtreeNodeCount</dd>
                <dt>Explizite Inhalte</dt>
                <dd data-testid="delete-contents">@_preview.ContentCount</dd>
                <dt>Entfernte Dependencies</dt>
                <dd data-testid="delete-removed-dependencies">@_preview.RemovedDependencyCount</dd>
                <dt>Erhaltene Quellreferenzen</dt>
                <dd data-testid="delete-retained-dependencies">@_preview.RetainedSourceDependencyCount</dd>
            </dl>
            @if (_preview.RetainedSourceDependencyCount > 0)
            {
                <InlineAlert Kind="AlertKind.Warnung" Message="Quellreferenzen bleiben als Provenienz erhalten; betroffener abgeleiteter Content wird stale." />
            }
            @if (_preview.DirectChildCount > 0)
            {
                <label class="node-deletion-subtree" for="delete-subtree">
                    <input id="delete-subtree" data-testid="delete-subtree" type="checkbox" @bind="_deleteSubtree" />
                    Gesamten Teilbaum löschen (@_preview.SubtreeNodeCount Nodes)
                </label>
                @if (!_deleteSubtree)
                {
                    <InlineAlert Kind="AlertKind.Warnung" Message="Die Node hat Children und kann ohne Teilbaum-Löschung nicht gelöscht werden." />
                }
            }
            <div class="node-metadata-actions">
                <button type="button" class="btn btn-danger" @onclick="OpenConfirmationAsync" disabled="@(!_deleteSubtree && _preview.DirectChildCount > 0)" data-testid="confirm-delete-node">
                    Löschung bestätigen
                </button>
                <button type="button" class="btn btn-secondary" @onclick="CancelPreview" data-testid="cancel-delete-node">Abbrechen</button>
            </div>
        </div>
    }
</section>

<ConfirmationDialog @ref="_confirmationDialog"
                    Title="Node löschen"
                    Message="@ConfirmationMessage"
                    ConfirmText="Endgültig löschen"
                    IsDestructive="true"
                    OnConfirm="ConfirmDeleteAsync" />
