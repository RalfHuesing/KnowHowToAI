@using KnowHowToAI.Core.Application.Mutations.Nodes
@using KnowHowToAI.Core.Domain.Common
@using KnowHowToAI.Server.Web.Components.Shared.Feedback
@using KnowHowToAI.Server.Web.Components.Shared.Tabs
@using Microsoft.AspNetCore.Components.Web
@namespace KnowHowToAI.Server.Web.Features.Knowledge.Components

<section class="node-metadata-editor" aria-label="Node-Titel und Beschreibung" data-testid="node-metadata-editor">
    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
    <TabPanelLayout>
        <PrimaryContent>
    @if (_errorMessage is not null)
    {
        <InlineAlert Kind="AlertKind.Fehler" Message="@_errorMessage" />
    }

    @foreach (var warning in _warnings)
    {
        <div role="status" data-testid="node-metadata-warning-@warning.Code">
            <strong>@warning.Code</strong> @warning.Message
        </div>
    }

        <div class="node-metadata-fields">
            <div>
                <label for="node-metadata-title">Titel</label>
                <input id="node-metadata-title" data-testid="node-metadata-title"
                       @bind="_title" @bind:event="oninput" @bind:after="UpdateDirty"
                       maxlength="200" disabled="@_isSubmitting" />
            </div>
            <div>
                <label for="node-metadata-description">Beschreibung</label>
                <textarea id="node-metadata-description" data-testid="node-metadata-description"
                          @bind="_description" @bind:event="oninput" @bind:after="UpdateDirty"
                          maxlength="1000" disabled="@_isSubmitting"></textarea>
            </div>
        </div>
        </PrimaryContent>
        <Actions>
            <div class="node-metadata-actions action-group">
                <button type="button" class="btn btn-secondary" @onclick="Cancel" disabled="@_isSubmitting">
                    Abbrechen
                </button>
                <button type="submit" class="btn btn-primary" disabled="@_isSubmitting" data-testid="save-node-metadata">
                    @(_isSubmitting ? "Wird gespeichert…" : "Speichern")
                </button>
            </div>
        </Actions>
    </TabPanelLayout>
    </form>
</section>
