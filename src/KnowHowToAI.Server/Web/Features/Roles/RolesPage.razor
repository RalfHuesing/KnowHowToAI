@page "/roles"
@namespace KnowHowToAI.Server.Web.Features.Roles
@using KnowHowToAI.Server.Web.Components.Shared.Feedback
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Rollen – KnowHowToAI</PageTitle>

<section class="roles-page" data-testid="roles-page">
    <header class="roles-page__header">
        <h1>Wissensrollen</h1>
        <p>Zielgruppenrollen für den versionierten Wissensinhalt. Rollen sind keine Authentifizierungs- oder ACL-Rollen.</p>
    </header>

    @if (_isLoading)
    {
        <p class="loading-state" role="status" data-testid="roles-loading">Rollen werden geladen…</p>
    }
    else if (_contextErrorMessage is not null)
    {
        <div role="alert" data-testid="roles-context-error">
            <InlineAlert Kind="AlertKind.Fehler" Message="@_contextErrorMessage" />
        </div>
    }
    else
    {
        <RoleEditor ReadContext="_readContext"
                    ChangeVersion="CurrentChangeVersion"
                    MutationSucceeded="HandleMutationSucceededAsync" />
    }
</section>
