@page "/search"
@using KnowHowToAI.Server.Web.Components.Shared.Feedback
@using Microsoft.AspNetCore.Components.Web
@namespace KnowHowToAI.Server.Web.Features.Search

<PageTitle>Suche – KnowHowToAI</PageTitle>

<section class="page-frame search-page" data-testid="search-page">
    <header class="search-page__header">
        <h1>Wissenssuche</h1>
        <p class="readable">Durchsucht Titel, Beschreibungen und den für die gewählte Zielgruppe aufgelösten Inhalt.</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(_contextErrorMessage))
    {
        <div data-testid="search-context-error" role="alert">
            <InlineAlert Kind="AlertKind.Fehler" Message="@_contextErrorMessage" />
        </div>
    }
    else if (_hasNoAudiences)
    {
        <div data-testid="search-empty-audiences" role="status">
            <InlineAlert Kind="AlertKind.Info" Message="Im aktuellen Wissenskontext sind keine Zielgruppen definiert." />
        </div>
    }
    else if (_isReady)
    {
        <SearchForm IsSearching="@_isSearching" OnSearch="StartSearchAsync" />
        <KnowledgeFilter Filter="@_filter" Audiences="@_filterAudiences" IsSearching="@_isSearching" OnChanged="ApplyFilterAsync" />
        <SearchResults Page="@_page" IsSearching="@_isSearching" ErrorMessage="@_searchErrorMessage" HasFilter="@(!_filter.IsEmpty)"
                       OnNext="LoadNextPageAsync" OnNavigate="NavigateToNode" />
    }
</section>
