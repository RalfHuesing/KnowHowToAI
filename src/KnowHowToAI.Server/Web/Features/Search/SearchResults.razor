@namespace KnowHowToAI.Server.Web.Features.Search
@using KnowHowToAI.Server.Web.Components.Shared.Feedback
@using Microsoft.AspNetCore.Components.Web

@if (IsSearching)
{
    <div class="search-results__loading" role="status" data-testid="search-loading">Suche läuft …</div>
}
else if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div data-testid="search-error" role="alert">
        <InlineAlert Kind="AlertKind.Fehler" Message="@ErrorMessage" />
    </div>
}
else if (Page is { } resultPage && resultPage.Items.Count == 0)
{
    <p class="search-results__empty" data-testid="search-empty" role="status">
        Keine Treffer für „@resultPage.Query“ gefunden.
    </p>
}
else if (Page is { } results)
{
    <section class="search-results" aria-label="Suchtreffer" data-testid="search-results">
        <p class="search-results__summary">@results.Items.Count Treffer auf dieser Seite</p>
        <ol class="search-results__list">
            @foreach (var hit in results.Items)
            {
                <li class="search-results__item">
                    <button type="button" class="search-results__node" @onclick="() => OnNavigate.InvokeAsync(hit.NodeId)"
                            data-testid="search-result-@hit.NodeId">
                        <span class="search-results__title">@hit.Title</span>
                        <span class="search-results__breadcrumb" aria-label="Pfad zum Treffer">
                            @string.Join(" › ", hit.Breadcrumb)
                        </span>
                        @if (!string.IsNullOrWhiteSpace(hit.Snippet))
                        {
                            <span class="search-results__snippet">@hit.Snippet</span>
                        }
                        <span class="search-results__metadata">Treffer in @MapHitField(hit.HitField)</span>
                    </button>
                </li>
            }
        </ol>
        @if (!string.IsNullOrEmpty(results.NextCursor))
        {
            <button type="button" class="search-results__next" @onclick="OnNext" data-testid="search-next">
                Weitere Treffer
            </button>
        }
    </section>
}
