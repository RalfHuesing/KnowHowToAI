@page "/audiences"
@namespace KnowHowToAI.Server.Web.Features.Audiences
@using KnowHowToAI.Server.Web.Components.Shared.Feedback
@using KnowHowToAI.Server.Web.Components.Shared
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Zielgruppen – KnowHowToAI</PageTitle>

<PageFrame Title="Zielgruppen"
           Description="Zielgruppen für den versionierten Wissensinhalt. Zielgruppen sind keine Authentifizierungs- oder ACL-Berechtigungen."
           Class="audiences-page"
           data-testid="audiences-page">

    @if (_isLoading)
    {
        <p class="loading-state" role="status" data-testid="audiences-loading">Zielgruppen werden geladen…</p>
    }
    else if (_contextErrorMessage is not null)
    {
        <div role="alert" data-testid="audiences-context-error">
            <InlineAlert Kind="AlertKind.Fehler" Message="@_contextErrorMessage" />
        </div>
    }
    else
    {
        <AudienceEditor ReadContext="_readContext"
                    ChangeVersion="CurrentChangeVersion"
                    MutationSucceeded="HandleMutationSucceededAsync" />
    }
</PageFrame>
