<section class="dashboard-card quality-summary" aria-labelledby="quality-summary-heading" data-testid="quality-summary">
    <h2 id="quality-summary-heading">Qualitätsübersicht (Current Snapshot)</h2>
    <p class="quality-info-note" data-testid="quality-info-note">Committed Snapshots besitzen definitionsgemäß keine harten Validierungsfehler.</p>

    @if (Quality.StaleContentCount == 0 && Quality.WarningCount == 0)
    {
        <p class="empty-state" data-testid="quality-clean">Keine Qualitätswarnungen oder veralteten Inhalte vorhanden.</p>
    }
    else
    {
        <div class="quality-sections">
            <div class="quality-section" data-testid="stale-contents-section">
                <h3>Veraltete abgeleitete Inhalte (@Quality.StaleContentCount)</h3>
                @if (Quality.StaleContentCount > 0)
                {
                    <ul class="quality-list" data-testid="stale-contents-list">
                        @foreach (var stale in Quality.StaleContents)
                        {
                            <li>
                                <a href="/knowledge/@stale.NodeId?roleId=@Uri.EscapeDataString(stale.RoleId)" class="dashboard-link">Node @stale.NodeId</a>
                                <span class="badge badge-warning">Rolle: @stale.RoleId</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="empty-hint">Keine veralteten Inhalte vorhanden.</p>
                }
            </div>

            <div class="quality-section" data-testid="warnings-section">
                <h3>Qualitätswarnungen über alle Rollen (@Quality.WarningCount)</h3>
                @if (Quality.WarningCount > 0)
                {
                    <ul class="quality-list" data-testid="warnings-list">
                        @foreach (var warning in Quality.Warnings)
                        {
                            <li class="warning-item"><code>@warning.Code</code>: @warning.Message
                                @if (warning.Details.Count > 0)
                                {
                                    <dl class="diagnostic-details">
                                        @foreach (var detail in warning.Details)
                                        {
                                            <dt>@detail.Key</dt>
                                            <dd>@detail.Value</dd>
                                        }
                                    </dl>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="empty-hint">Keine Qualitätswarnungen vorhanden.</p>
                }
            </div>
        </div>
    }
</section>
