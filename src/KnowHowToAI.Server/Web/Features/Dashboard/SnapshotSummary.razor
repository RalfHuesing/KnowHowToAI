@using KnowHowToAI.Server.Web.Features.History

<section class="dashboard-card snapshot-summary" aria-labelledby="snapshot-summary-heading" data-testid="snapshot-summary">
    <h2 id="snapshot-summary-heading">Aktueller Wissensstand &amp; Release</h2>
    <div class="summary-grid">
        <div class="summary-item" data-testid="current-snapshot-info">
            <h3>Current Snapshot</h3>
            <dl>
                <dt>Snapshot-ID:</dt>
                <dd data-testid="current-snapshot-id">@CurrentSnapshot.SnapshotId</dd>
                <dt>Status:</dt>
                <dd data-testid="current-snapshot-state">@CurrentSnapshot.State</dd>
                <dt>Erstellt am:</dt>
                <dd data-volatile="" title="@CurrentSnapshot.CreatedAtUtc.ToString("u")">@CurrentSnapshot.CreatedAtUtc.ToString("g")</dd>
                <dt>Basis-Snapshot:</dt>
                <dd data-testid="current-snapshot-base">@(CurrentSnapshot.BaseSnapshotId?.ToString() ?? "Keiner (Initialer Stand)")</dd>
            </dl>
        </div>
        <div class="summary-item" data-testid="latest-release-info">
            <h3>Letzter Release</h3>
            @if (LatestRelease is not null)
            {
                <dl>
                    <dt>Name:</dt>
                    <dd data-testid="latest-release-name">@LatestRelease.Name</dd>
                    <dt>Veröffentlicht am:</dt>
                    <dd data-volatile="" title="@LatestRelease.ReleasedAtUtc.ToString("u")">@LatestRelease.ReleasedAtUtc.ToString("g")</dd>
                    <dt>Snapshot-ID:</dt>
                    <dd>@LatestRelease.SnapshotId</dd>
                    @if (!string.IsNullOrWhiteSpace(LatestRelease.Description))
                    {
                        <dt>Beschreibung:</dt>
                        <dd>@LatestRelease.Description</dd>
                    }
                </dl>
            }
            else
            {
                <p class="empty-hint" data-testid="no-release-hint">Noch kein Release veröffentlicht.</p>
            }
        </div>
    </div>
    <div class="card-actions">
        <a href="/knowledge" class="dashboard-link" data-testid="link-knowledge">Wissensbaum öffnen</a>
        <a href="/history" class="dashboard-link" data-testid="link-history">Historie &amp; Releases anzeigen</a>
    </div>
</section>
