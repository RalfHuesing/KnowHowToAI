@namespace KnowHowToAI.Server.Web.Components.Layout.Shell

<NavigationLock ConfirmExternalNavigation="@IsDirty"
                OnBeforeInternalNavigation="HandleBeforeInternalNavigation" />

<ConfirmationDialog @ref="_confirmationDialog"
                    Title="Ungespeicherte Änderungen"
                    Message="Sie haben ungespeicherte Änderungen. Möchten Sie die Seite wirklich verlassen? Ihre ungespeicherten Eingaben gehen dabei verloren."
                    ConfirmText="Seite verlassen"
                    IsDestructive="false"
                    OnConfirm="ConfirmLeavePageAsync"
                    OnCancel="CancelLeavePageAsync" />
