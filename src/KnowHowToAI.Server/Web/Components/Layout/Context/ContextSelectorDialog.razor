@namespace KnowHowToAI.Server.Web.Components.Layout.Context
@using KnowHowToAI.Server.Web.Components.Shared.Dialogs
@using KnowHowToAI.Server.Web.State

@if (State.IsOpen)
{
    <AppDialog @ref="_dialog" Title="@DialogTitle" OnClosed="HandleDialogClosedAsync" OnReady="OpenDialogAsync">
        <div class="context-selector-dialog" data-testid="context-selector-dialog">
            <ContextSelectionForm />
        </div>
    </AppDialog>
}
