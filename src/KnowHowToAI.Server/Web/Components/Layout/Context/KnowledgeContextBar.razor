@namespace KnowHowToAI.Server.Web.Components.Layout.Context
@using KnowHowToAI.Server.Web.Components.Shared.Feedback

@* Globale Wissenskontextleiste nahe der Wortmarke: Werte als Text und
   Status, ohne Selektor, Links oder Mutation. Die fehlende Rolle ist
   neutral und kein technischer Fehler; der Dirty-Zustand nutzt AppStatus
   mit Icon plus Text, nie Farbe allein. *@
<div class="knowledge-context" role="group" aria-label="Wissenskontext" data-ktai-dirty="@(Context.IsDirty ? "true" : "false")">
    <span class="knowledge-context__segment knowledge-context__segment--snapshot" data-testid="context-snapshot-segment">
        <span class="knowledge-context__label">Wissensbasis:</span>
        <span class="knowledge-context__value">@ReadContextText</span>
    </span>
    @if (!IsTransactionContext && ReadContextDetail is { } detail)
    {
        <span class="knowledge-context__segment knowledge-context__segment--detail" data-testid="context-detail-segment">
            <span class="knowledge-context__label">Bereich:</span>
            <span class="knowledge-context__value knowledge-context__detail">@detail</span>
        </span>
    }
    @if (HasWorkingTransactionData)
    {
        <span class="knowledge-context__segment knowledge-context__segment--working" data-testid="context-working-transaction">
            <span class="knowledge-context__label">Working-Transaction:</span>
            @if (IsTransactionContext && ReadContextDetail is { } workingDetail)
            {
                <span class="knowledge-context__value knowledge-context__detail knowledge-context__working-value">@workingDetail</span>
            }
            @if (HasTechnicalTransactionValues)
            {
                <span class="knowledge-context__technical" aria-label="Technische Transaktionsdaten">
                    @if (Context.BaseSnapshotId is not null)
                    {
                        <span class="knowledge-context__technical-item" data-testid="context-base-snapshot">
                            <span class="knowledge-context__technical-label">Base-Snapshot:</span>
                            <span class="knowledge-context__value">@Context.BaseSnapshotId</span>
                        </span>
                    }
                    @if (Context.ChangeVersion is not null)
                    {
                        <span class="knowledge-context__technical-item" data-testid="context-change-version">
                            <span class="knowledge-context__technical-label">Änderungsversion:</span>
                            <span class="knowledge-context__value">@Context.ChangeVersion</span>
                        </span>
                    }
                </span>
            }
        </span>
    }
    <span class="knowledge-context__segment knowledge-context__segment--role">
        <span class="knowledge-context__label">Rolle:</span>
        <span class="knowledge-context__value">@RoleText</span>
    </span>
    @if (Context.IsDirty)
    {
        <span class="knowledge-context__segment knowledge-context__segment--status">
            <AppStatus Kind="AppStatusKind.Ungespeichert" Text="Ungespeicherte Änderungen" />
        </span>
    }
    @if (OnOpenSelector.HasDelegate)
    {
        <span class="knowledge-context__segment knowledge-context__segment--action">
            <button type="button" class="knowledge-context__trigger"
                    @onclick="HandleOpenSelectorAsync"
                    aria-label="Kontext und Rolle anpassen"
                    title="Kontext und Rolle anpassen"
                    data-testid="context-selector-trigger">
                Anpassen
            </button>
        </span>
    }
</div>
