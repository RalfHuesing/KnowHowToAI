@namespace KnowHowToAI.Server.Web.Components.Layout.Context
@using KnowHowToAI.Server.Web.Components.Shared.Feedback
@using KnowHowToAI.Server.Web.State

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="context-selector-dialog__error" role="alert" data-testid="selector-error">
        <InlineAlert Kind="AlertKind.Fehler" Message="@_errorMessage" />
    </div>
}

@if (State.Mode == ContextSelectorMode.Full)
{
    <ContextReadContextOptions Draft="_draft"
                               Options="_options"
                               OnKindChanged="SelectKindAsync"
                               OnSelectionChanged="OnContextParameterChangedAsync" />
}

<p class="context-selector-dialog__purpose" data-testid="selector-purpose">
    Die Rolle bestimmt, für welche Zielgruppe der Wissensinhalt aufbereitet ist.
    @if (State.Mode == ContextSelectorMode.MandatoryRole)
    {
        <text>Nach der Auswahl wird die Wissensbasis in dieser Perspektive geöffnet.</text>
    }
    else
    {
        <text>Nach dem Übernehmen sehen Sie die Wissensbasis in dieser Perspektive.</text>
    }
    Die Rolle ist ein Inhaltskontext, keine Zugriffsberechtigung.
</p>

<fieldset class="context-selector-dialog__group">
    <legend class="context-selector-dialog__legend">
        @(State.Mode == ContextSelectorMode.MandatoryRole ? "Rolle auswählen (Pflichtauswahl)" : "Rolle auswählen")
    </legend>
    @if (_isLoadingRoles)
    {
        <div class="context-selector-dialog__loading" role="status">Lade Rollen...</div>
    }
    else if (_options.Roles.Count == 0)
    {
        <p class="context-selector-dialog__empty" data-testid="empty-roles-message">
            Keine Rollen im aktuellen Kontext vorhanden.
        </p>
    }
    else
    {
        <div class="context-selector-dialog__roles" role="radiogroup" aria-label="Verfügbare Rollen">
            @foreach (var role in _options.Roles)
            {
                <label class="context-selector-dialog__role-option" data-testid="role-option-@role.Id">
                    <input type="radio" name="selectedRole" value="@role.Id"
                           checked="@(_selectedRoleId == role.Id)"
                           @onchange="@(() => _selectedRoleId = role.Id)" />
                    <span class="context-selector-dialog__role-name">@role.Name</span>
                    @if (!string.IsNullOrWhiteSpace(role.Description))
                    {
                        <span class="context-selector-dialog__role-desc">@role.Description</span>
                    }
                </label>
            }
        </div>
    }
</fieldset>

<div class="context-selector-dialog__actions">
    @if (State.Mode == ContextSelectorMode.Full)
    {
        <button type="button" class="context-selector-dialog__button context-selector-dialog__button--secondary"
                @onclick="Cancel" data-testid="selector-cancel-button">
            Abbrechen
        </button>
    }
    <button type="button" class="context-selector-dialog__button context-selector-dialog__button--primary"
            disabled="@(_isLoadingRoles || (_options.Roles.Count > 0 && string.IsNullOrWhiteSpace(_selectedRoleId)))"
            @onclick="ApplyAsync" data-testid="selector-apply-button">
        @(State.Mode == ContextSelectorMode.MandatoryRole ? "Auswählen" : "Übernehmen")
    </button>
</div>
