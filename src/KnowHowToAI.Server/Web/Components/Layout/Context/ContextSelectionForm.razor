@namespace KnowHowToAI.Server.Web.Components.Layout.Context
@using KnowHowToAI.Server.Web.Components.Shared.Feedback
@using KnowHowToAI.Server.Web.State

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="context-selector-dialog__error" role="alert" data-testid="selector-error">
        <InlineAlert Kind="AlertKind.Fehler" Message="@_errorMessage" />
    </div>
}

@if (State.Mode == ContextSelectorMode.Full)
{
    <ContextReadContextOptions Draft="_draft"
                               Options="_options"
                               OnKindChanged="SelectKindAsync"
                               OnSelectionChanged="OnContextParameterChangedAsync" />
}

<p class="context-selector-dialog__purpose" data-testid="selector-purpose">
    Die Auswahl bestimmt, für welche Zielgruppe der Wissensinhalt aufbereitet ist.
    @if (State.Mode == ContextSelectorMode.MandatoryAudience)
    {
        <text>Nach der Auswahl wird die Wissensbasis in dieser Perspektive geöffnet.</text>
    }
    else
    {
        <text>Nach dem Übernehmen sehen Sie die Wissensbasis in dieser Perspektive.</text>
    }
    Die Zielgruppe ist ein Inhaltskontext, keine Zugriffsberechtigung.
</p>

<fieldset class="context-selector-dialog__group">
    <legend class="context-selector-dialog__legend">
        @(State.Mode == ContextSelectorMode.MandatoryAudience ? "Zielgruppe auswählen (Pflichtauswahl)" : "Zielgruppe auswählen")
    </legend>
    @if (_isLoadingAudiences)
    {
        <div class="context-selector-dialog__loading" role="status">Lade Zielgruppen...</div>
    }
    else if (_options.Audiences.Count == 0)
    {
        <p class="context-selector-dialog__empty" data-testid="empty-audiences-message">
            Keine Zielgruppen im aktuellen Kontext vorhanden.
        </p>
    }
    else
    {
        <div class="context-selector-dialog__audiences" role="radiogroup" aria-label="Verfügbare Zielgruppen">
            @foreach (var audience in _options.Audiences)
            {
                <label class="context-selector-dialog__audience-option" data-testid="audience-option-@audience.Id">
                    <input type="radio" name="selectedAudience" value="@audience.Id"
                           checked="@(_selectedAudienceId == audience.Id)"
                           @onchange="@(() => _selectedAudienceId = audience.Id)" />
                    <span class="context-selector-dialog__audience-name">@audience.Name</span>
                    @if (!string.IsNullOrWhiteSpace(audience.Description))
                    {
                        <span class="context-selector-dialog__audience-desc">@audience.Description</span>
                    }
                </label>
            }
        </div>
    }
</fieldset>

<div class="context-selector-dialog__actions">
    @if (State.Mode == ContextSelectorMode.Full)
    {
        <button type="button" class="context-selector-dialog__button context-selector-dialog__button--secondary"
                @onclick="Cancel" data-testid="selector-cancel-button">
            Abbrechen
        </button>
    }
    <button type="button" class="context-selector-dialog__button context-selector-dialog__button--primary"
            disabled="@(_isLoadingAudiences || (_options.Audiences.Count > 0 && string.IsNullOrWhiteSpace(_selectedAudienceId)))"
            @onclick="ApplyAsync" data-testid="selector-apply-button">
        @(State.Mode == ContextSelectorMode.MandatoryAudience ? "Auswählen" : "Übernehmen")
    </button>
</div>
