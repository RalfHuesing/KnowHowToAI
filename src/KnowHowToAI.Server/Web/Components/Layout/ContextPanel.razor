@namespace KnowHowToAI.Server.Web.Components.Layout

<aside id="shell-context" aria-label="Kontext" class="shell-panel shell-panel--context"
       @onkeydown="HandleKeydown">
    <div class="shell-panel-header">
        <h2 class="shell-panel-title" tabindex="-1" @ref="_titleElement">Kontext</h2>
        <button type="button" class="shell-panel-close" @onclick="OnClose">Kontext schließen</button>
    </div>
    <div class="shell-panel-content">
        @Content
    </div>
</aside>
