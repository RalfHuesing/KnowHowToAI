@namespace KnowHowToAI.Server.Web.Components.Shared

@* Initial Load: wahrnehmbarer Status statt endlos leerer Fläche. Die
   Statusrolle kündigt die Meldung höflich und einmalig an; das Icon ist
   für die Assistenztechnik verborgen, weil der Text die Bedeutung trägt. *@
<div class="loading-state" role="status" aria-live="polite" aria-busy="true">
    <svg class="loading-state__spinner" width="24" height="24" viewBox="0 0 24 24"
         fill="none" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5"
                stroke-dasharray="42 15" stroke-linecap="round" />
    </svg>
    <span class="loading-state__message">@Message</span>
</div>
