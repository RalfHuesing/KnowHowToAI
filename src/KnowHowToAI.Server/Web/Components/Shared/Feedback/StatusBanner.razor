@namespace KnowHowToAI.Server.Web.Components.Shared.Feedback

@* Seitenweiter Zustand: gilt für die gesamte Seite und nicht für einen
   einzelnen Inhalt. Die Ankündigung folgt der Stufe; Inhalt und Farbe
   kommen aus der zentralen Statusdarstellung, die Kante markiert die
   Stufe zusätzlich zur Farbe. *@
<div class="status-banner status-banner--@Kind.ToString().ToLowerInvariant()"
     role="@(Kind == AlertKind.Fehler ? "alert" : "status")">
    <AppStatus Kind="@StatusKind" Text="@Message" />
</div>
