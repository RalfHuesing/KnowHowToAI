@namespace KnowHowToAI.Server.Web.Components.Shared

@* Teilaktualisierung: der Inhalt bleibt sichtbar und wird nur halb
   abgedeckt; der Scrim blockiert Zeigerinteraktion, das inert-Attribut
   sperrt Kindinhalt gegen Doppelaktion und Fokus. Die Statusmeldung
   erscheint nur während der Laufzeit und wird höflich angekündigt. *@
<div class="busy-overlay @(IsBusy ? "busy-overlay--busy" : string.Empty)"
     aria-busy="@(IsBusy ? "true" : "false")">
    <div class="busy-overlay__content" inert="@(IsBusy ? "true" : null)">
        @ChildContent
    </div>
    @if (IsBusy)
    {
        <div class="busy-overlay__scrim" aria-hidden="true"></div>
        <p class="busy-overlay__status" role="status" aria-live="polite">@BusyText</p>
    }
</div>
